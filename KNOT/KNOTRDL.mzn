array[0..3] of int: shiftConst = array1d(0..3, [0, 1, 8, 25]);

/*
--------------------------------- Differential part -------------------------------------
*/
predicate difRoundAddRoundConstant(array[int, int] of var 0..1: a, array[int, int] of var 0..1: b, array[int] of 0..1: RC) = 
    forall(i in 0..3, j in 0..rowSize-1)
    (
      if i == 0 then 
        (a[0, j] + b[0, j] + RC[j] + RC[(rowSize + j - rot) mod rowSize]) in {0,2,4}
      else
        a[i,j] = b[i,j]
      endif
    );
    
predicate difRoundSubColumn(array[int, int] of var 0..1: a, array[int, int] of var 0..1: b, array[int] of var int: pLog2) = 
    forall(i in 0..rowSize-1)
    (
      table([a[0,i],a[1,i],a[2,i],a[3,i],b[0,i],b[1,i],b[2,i],b[3,i],pLog2[i]], DDT)
    );
    
predicate difRoundShiftRow(array[int, int] of var 0..1: a, array[int, int] of var 0..1: b) = 
    forall(i in 0..3, j in 0..rowSize-1)
    (
      b[i, j] = a[i, (rowSize+j-shiftConst[i]) mod rowSize] 
    );

predicate difRound(array[int, int] of var 0..1: a, array[int, int] of var 0..1: b, var int: pLog2, int: r) = 
    let {
      array[0..3, 0..rowSize-1] of var 0..1: tmp0;
      array[0..3, 0..rowSize-1] of var 0..1: tmp1;
      array[0..rowSize-1] of var int: pLog2PerSbox;
    }
    in
      difRoundSubColumn(a, tmp0, pLog2PerSbox)
      /\
      difRoundShiftRow(tmp0, tmp1)
      /\
      difRoundAddRoundConstant(tmp1, b, RCs[r+1,..])
      /\
      pLog2 = sum(i in 0..rowSize-1)(pLog2PerSbox[i]);

    
/*
--------------------------------- DL differential part -------------------------------------
*/
predicate DLDifRoundAddRoundConstant(array[int, int] of var -1..1: a, array[int, int] of var -1..1: b, array[int] of 0..1: RC) =
    forall(i in 0..3, j in 0..rowSize-1)
    (
      if i == 0 then 
        if a[0, j] == -1 then
          b[0,j] == -1
        else
          (a[0, j] + b[0, j] + RC[j] + RC[(rowSize + j - rot) mod rowSize]) in {0,2,4} /\ b[0, j] >= 0
        endif
      else
        b[i,j] = a[i,j]
      endif
    ); 
    
predicate DLDifRoundSubColumn(array[int, int] of var -1..1: a, array[int, int] of var -1..1: b) = 
    forall(i in 0..rowSize-1)
    (
      if a[0,i] == 0 /\ a[1,i] == 0 /\ a[2,i] == 0 /\ a[3,i] == 0 then
        b[0,i] == 0 /\ b[1,i] == 0 /\ b[2,i] == 0 /\ b[3,i] == 0
      elseif a[0,i] == 1 /\ a[1,i] == 0 /\ a[2,i] == 0 /\ a[3,i] == 0 then
        b[0,i] == -1 /\ b[1,i] == -1 /\ b[2,i] == 1 /\ b[3,i] == -1
      elseif a[0,i] == 0 /\ a[1,i] == 0 /\ a[2,i] == 1 /\ a[3,i] == 0 then
        b[0,i] == -1 /\ b[1,i] == -1 /\ b[2,i] == -1 /\ b[3,i] == 1
      elseif a[0,i] == 0 /\ a[1,i] == 0 /\ a[2,i] == 0 /\ a[3,i] == 1 then
        b[0,i] == -1 /\ b[1,i] == -1 /\ b[2,i] == 1 /\ b[3,i] == 1
      elseif a[0,i] == 1 /\ a[1,i] == 0 /\ a[2,i] == 0 /\ a[3,i] == 1 then
        b[0,i] == -1 /\ b[1,i] == -1 /\ b[2,i] == 0 /\ b[3,i] == -1
      elseif a[0,i] == 0 /\ a[1,i] == 0 /\ a[2,i] == 1 /\ a[3,i] == 1 then
        b[0,i] == -1 /\ b[1,i] == -1 /\ b[2,i] == -1 /\ b[3,i] == 0
      else
        b[0,i] == -1 /\ b[1,i] == -1 /\ b[2,i] == -1 /\ b[3,i] == -1
      endif
    );
    
predicate DLDifRoundShiftRow(array[int, int] of var -1..1: a, array[int, int] of var -1..1: b) = 
    forall(i in 0..3, j in 0..rowSize-1)
    (
      b[i, j] = a[i, (rowSize+j-shiftConst[i]) mod rowSize] 
    );
    
predicate DLDifRound(array[int, int] of var -1..1: a, array[int, int] of var -1..1: b, int: r) = 
    let {
      array[0..3, 0..rowSize-1] of var -1..1: tmp0;
      array[0..3, 0..rowSize-1] of var -1..1: tmp1;
    }
    in
      DLDifRoundSubColumn(a, tmp0)
      /\
      DLDifRoundShiftRow(tmp0, tmp1)
      /\
      DLDifRoundAddRoundConstant(tmp1, b, RCs[r+1,..]);
      
    
/*
--------------------------------- Linear part -------------------------------------
*/ 
predicate linRoundSubColumn(array[int, int] of var 0..1: a, array[int, int] of var 0..1: b, array[int] of var int: cor2Log2) = 
    forall(i in 0..rowSize-1)
    (
      table([a[0,i],a[1,i],a[2,i],a[3,i],b[0,i],b[1,i],b[2,i],b[3,i],cor2Log2[i]], LAT2)
    );
    
predicate linRoundShiftRow(array[int, int] of var 0..1: a, array[int, int] of var 0..1: b) = 
    forall(i in 0..3, j in 0..rowSize-1)
    (
      b[i, j] = a[i, (rowSize+j-shiftConst[i]) mod rowSize] 
    );
    
    
predicate linRound(array[int, int] of var 0..1: a, array[int, int] of var 0..1: b, var int: cor2Log2, int: r) = 
    let {
      array[0..3, 0..rowSize-1] of var 0..1: tmp1;
      array[0..rowSize-1] of var int: cor2Log2PerSbox;
    }
    in
      linRoundSubColumn(a, tmp1, cor2Log2PerSbox)
      /\
      linRoundShiftRow(tmp1, b)
      /\
      cor2Log2 = sum(i in 0..rowSize-1)(cor2Log2PerSbox[i]);
    
/*
--------------------------------- DL Linear part -------------------------------------
*/  
predicate DLLinRoundSubColumn(array[int, int] of var -1..1: a, array[int, int] of var -1..1: b) = 
    forall(i in 0..rowSize-1)
    (
      if b[0,i] == 0 /\ b[1,i] == 0 /\ b[2,i] == 0 /\ b[3,i] == 0 then
        a[0,i] == 0 /\ a[1,i] == 0 /\ a[2,i] == 0 /\ a[3,i] == 0
      elseif b[0,i] == 0 /\ b[1,i] == 0 /\ b[2,i] == 1 /\ b[3,i] == 0 then
        a[0,i] == 1 /\ a[1,i] == -1 /\ a[2,i] == -1 /\ a[3,i] == 1
      elseif b[0,i] == 0 /\ b[1,i] == 0 /\ b[2,i] == 0 /\ b[3,i] == 1 then
        a[0,i] == -1 /\ a[1,i] == -1 /\ a[2,i] == 1 /\ a[3,i] == 1
      elseif b[0,i] == 0 /\ b[1,i] == 0 /\ b[2,i] == 1 /\ b[3,i] == 1 then
        a[0,i] == -1 /\ a[1,i] == -1 /\ a[2,i] == -1 /\ a[3,i] == 0
      else
        a[0,i] == -1 /\ a[1,i] == -1 /\ a[2,i] == -1 /\ a[3,i] == -1
      endif
    );
    
predicate DLLinRoundShiftRow(array[int, int] of var -1..1: a, array[int, int] of var -1..1: b) = 
    forall(i in 0..3, j in 0..rowSize-1)
    (
      b[i, j] = a[i, (rowSize+j-shiftConst[i]) mod rowSize] 
    );
    
predicate DLLinRound(array[int, int] of var -1..1: a, array[int, int] of var -1..1: b, int: r) = 
    let {
      array[0..3, 0..rowSize-1] of var -1..1: tmp1;
    }
    in
      DLLinRoundSubColumn(a, tmp1)
      /\
      DLLinRoundShiftRow(tmp1, b);
      
int: r0 = 4;
int: r1 = 4;
int: rm = 8;

array[0..r0, 0..4*rowSize-1] of var 0..1: difPerRound;
array[0..r0-1] of var int: pLog2PerRound;
constraint forall(i in 0..r0-1)(difRound(array2d(0..3, 0..rowSize-1,difPerRound[i,..]), array2d(0..3, 0..rowSize-1,difPerRound[i+1,..]), pLog2PerRound[i], i));
var int: pU = sum(i in 0..r0-1)(pLog2PerRound[i]);
constraint if rot == 0 then sum(i in 0..4*rowSize-1)(difPerRound[0,i]) > 0 endif;

array[0..r1, 0..4*rowSize-1] of var 0..1: maskPerRound;
array[0..r1-1] of var int: cor2Log2PerRound;
constraint forall(i in 0..r1-1)(linRound(array2d(0..3, 0..rowSize-1,maskPerRound[i,..]), array2d(0..3, 0..rowSize-1,maskPerRound[i+1,..]), cor2Log2PerRound[i], i+r0+rm));
var int: cL = sum(i in 0..r1-1)(cor2Log2PerRound[i]);
constraint sum(i in 0..4*rowSize-1)(maskPerRound[r1,i]) > 0;

array[0..rm, 0..4*rowSize-1] of var -1..1: DLDifPerRound;
constraint forall(i in 0..4*rowSize-1)(DLDifPerRound[0,i] == difPerRound[r0,i]);
constraint forall(i in 0..rm-1)(DLDifRound(array2d(0..3, 0..rowSize-1,DLDifPerRound[i,..]), array2d(0..3, 0..rowSize-1,DLDifPerRound[i+1,..]), i+r0 ));

array[0..rm, 0..4*rowSize-1] of var -1..1: DLMaskPerRound;
constraint forall(i in 0..4*rowSize-1)(DLMaskPerRound[rm,i] == maskPerRound[0,i]);
constraint forall(i in 0..rm-1)(DLLinRound(array2d(0..3, 0..rowSize-1, DLMaskPerRound[i,..]), array2d(0..3, 0..rowSize-1, DLMaskPerRound[i+1,..]), i+r0));

var int: cM = sum(i in 0..rm-1, j in 0..4*rowSize-1)(bool2int(DLDifPerRound[i,j] == -1 /\ DLMaskPerRound[i,j] == -1 ));

%constraint forall(i in 0..b-inputCapacity-1)(difPerRound[0,i] == 0);
%constraint forall(i in outputRate..b-1)(maskPerRound[r1,i] == 0);

int: wu = 2;
int: wm = 1;   
int: wl = 2;

var int: obj = wu*pU + wm*cM + wl*cL;

solve minimize obj;
%solve satisfy;

output ["Diff propagation: \n"];
output ["\(difPerRound[i,..]) -- D \(pLog2PerRound[i]) \n" | i in 0..r0-1];

output ["Middle diff propagation: \n"];
output ["\(DLDifPerRound[i,..]) -- D \n" | i in 0..rm];

output ["Middle linear propagation: \n"];
output ["\(DLMaskPerRound[i,..]) -- L \n" | i in 0..rm];


output ["Linear propagation: \n"];
output ["\(maskPerRound[i,..]) -- L \(cor2Log2PerRound[i]) \n" | i in 0..r1-1];
output ["\(maskPerRound[r1,..]) \n"];

output ["\(pU) -- \(cM) -- \(cL)"];







    

